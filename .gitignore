*~
*.autosave
*.a
*.core
*.moc
*.o
*.obj
*.orig
*.rej
*.so
*.so.*
*_pch.h.cpp
*_resource.rc
*.qm
.#*
*.*#
core
!core/
tags
.DS_Store
.directory
*.debug
Makefile*
*.prl
*.app
moc_*.cpp
ui_*.h
qrc_*.cpp
Thumbs.db
*.res
*.rc
/.qmake.cache
/.qmake.stash

# Editor temp files (e.g. foo.cpp.tmp.12345.abcdef)
*.tmp.*

# qtcreator generated files
*.pro.user*
*.qbs.user*
CMakeLists.txt.user*

# xemacs temporary files
*.flc

# Vim temporary files
.*.swp

# Visual Studio generated files
*.ib_pdb_index
*.idb
*.ilk
*.pdb
*.sln
*.suo
*.vcproj
*vcproj.*.*.user
*.ncb
*.sdf
*.opensdf
*.vcxproj
*vcxproj.*

# MinGW generated files
*.Debug
*.Release

# Python byte code
*.pyc

# Binaries
# --------
*.dll
*.exe

# Directories with generated files
.moc/
.obj/
.pch/
.rcc/
.uic/
/build*/
/out/
/dist/
.vs/
.qtcreator/

# Cloudflare Wrangler (license-server) — local cache & deps, never commit
license-server/.wrangler/
**/.wrangler/
**/node_modules/
.dev.vars
*.dev.vars

# Secret bulk-upload files (Daraja/M-Pesa etc.) — never commit
*secrets*.json
mpesa-secrets.json

# SQLite databases (the POS db lives in AppData, but stay safe)
*.db
*.sqlite
*.sqlite3

# Mobile companion apps each live in their own independent git repo (not a
# submodule) — see mobile/keynetik_scanner/.git. Ignored here so this repo
# never tries to track it as embedded content.
/mobile/
